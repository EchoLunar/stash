---
name: 自用覆写
desc: 仅为 VMUTEX-Stash.yaml 注入两个订阅地址；请在本设备的参数中填写。
icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/AmyTelecom.png

# 需要支持覆写参数的 Stash：Beta iOS/tvOS 3.7+ 或 macOS 4.4+。
# 保持参数名不变；远程更新同一个已安装覆写时会保留已填写的值。
arguments-version: 1
arguments:
  subscription_a:
    type: input
    title: 第一个订阅地址
    description: 填写返回 Stash / Clash YAML（包含 proxies）的订阅链接。
    required: true
    max-length: 4096
  subscription_b:
    type: input
    title: 第二个订阅地址
    description: 填写返回 Stash / Clash YAML（包含 proxies）的订阅链接。
    required: true
    max-length: 4096

# 不加 #!replace：仅递归合并 url，保留主配置中的 path、interval 等字段。
proxy-providers:
  SubscriptionA:
    url: '${args.subscription_a}'
  SubscriptionB:
    url: '${args.subscription_b}'
