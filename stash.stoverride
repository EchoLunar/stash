---
name: 自用覆写
desc: 3x-ui 仅负责下发节点；本覆写接管 DNS、策略组、规则和规则集。🍻！
icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/AmyTelecom.png

mode: rule
log-level: warning
ipv6: true
unified-delay: true

profile:
  store-selected: true

# 仅追加一个可被 include-all 收纳的直连节点；不替换 3x-ui 下发的真实节点。
# 使用独立名称，避免和 Stash 内置 DIRECT 策略重名。
proxies:
  - name: DIRECT-Local
    type: direct

# 完全替换订阅中的 DNS，避免与 3x-ui 生成配置递归合并。
dns: #!replace
  enable: true
  use-system-hosts: false
  ipv6: true
  listen: 0.0.0.0:53
  # 采用上游白名单模板的 Redir-Host 方案；真实 IP 交给后续 GEOIP,CN 判断。
  enhanced-mode: redir-host

  default-nameserver:
    - 119.29.29.29
    - 223.5.5.5

  # 参考模板的 DNS 分流：国内域名使用国内 DoH，其他域名使用境外 DoH。
  # Stash 的 nameserver-policy 不能直接引用远程 RULE-SET，因此这里保留 geosite:cn；
  # 具体的 GeositeCN_Domain 规则在下方普通分流规则中负责国内域名匹配。
  nameserver:
    - https://cloudflare-dns.com/dns-query
    - https://dns.google/dns-query

  nameserver-policy:
    'geosite:cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

    # 上游模板 Stash_Compatible 的 GeositeCN 手工展开；命中后只使用阿里 DNS。
    # 这些显式域名优先于上面的 geosite:cn 策略。
    '+.115.com': https://dns.alidns.com/dns-query
    '+.115cdn.com': https://dns.alidns.com/dns-query
    '+.115cdn.net': https://dns.alidns.com/dns-query
    '+.115cloud.com': https://dns.alidns.com/dns-query
    '+.115cloud.net': https://dns.alidns.com/dns-query
    '+.115img.com': https://dns.alidns.com/dns-query
