  # 代理节点本身也是域名（多数位于 Cloudflare），使用独立 DoH 解析，避免连接代理时形成 DNS 递归。
  proxy-server-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query

  # 普通 DNS 查询按代理规则转发；代理节点域名仍由上面的独立解析器解析。
  follow-rule: true

# 不覆写 proxies。所有真实节点始终由 3x-ui 订阅下发。
# Proxy 是所有未命中规则流量的代理入口；AI、Talkatone、Binance 和 Bybit
# 按需直接收纳订阅中的全部节点。
proxy-groups: #!replace
  - name: Proxy
    type: select
    include-all: true

  - name: Final
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: AI
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: Apple
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: APNs
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: TestFlight
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: YouTube
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: Telegram
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Talkatone
    type: select
    include-all: true

  - name: Binance
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: Bybit
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: TikTok
    type: select
    include-all: true
    proxies:
      - DIRECT

rules: #!replace
  # 个人固定例外：Oracle VPS 及 Oracle 控制台域名直连。
  # cloud.oracle.com 属于 oracle.com，DOMAIN-SUFFIX 会覆盖其子域名。
  - IP-CIDR,149.118.147.51/32,DIRECT,no-resolve
  - IP-CIDR6,2603:c030:304:9f01:0:49da:2c15:4454/128,DIRECT,no-resolve
  - DOMAIN-SUFFIX,oracle.com,DIRECT
  - DOMAIN-SUFFIX,oraclecloud.com,DIRECT

  # 个人固定代理例外。
  - DOMAIN-SUFFIX,dmit.io,Proxy
  - DOMAIN-SUFFIX,4hu.com,Proxy
  - DOMAIN-SUFFIX,4hu.tv,Proxy

  # follow-rule 下固定上游 DNS 的出站路径：国内 DoH 直连，境外 DoH 走代理。
  - DOMAIN-SUFFIX,doh.pub,DIRECT
  - DOMAIN-SUFFIX,dns.alidns.com,DIRECT
  - DOMAIN-SUFFIX,cloudflare-dns.com,Proxy
  - DOMAIN-SUFFIX,dns.google,Proxy
  - GEOSITE,category-ads,REJECT-DROP

  - DOMAIN-SUFFIX,talkatone.com,Talkatone
  - DOMAIN-SUFFIX,tktn.be,Talkatone
  - DOMAIN-SUFFIX,tktn.at,Talkatone
  - RULE-SET,Binance,Binance
  - DOMAIN-KEYWORD,binance,Binance
  - RULE-SET,Bybit,Bybit
  - RULE-SET,APNs,APNs
  - RULE-SET,TestFlight,TestFlight
  - RULE-SET,Reject,REJECT

  - RULE-SET,AI,AI
  - RULE-SET,YouTube,YouTube
  - RULE-SET,Telegram,Telegram
  - RULE-SET,TikTok,TikTok
  - RULE-SET,AppleCN,DIRECT
  - RULE-SET,AppleServers,Apple
  # 以下是国内识别链：域名规则优先，GEOIP,CN 只负责 IP 兜底。
  - RULE-SET,GeositeCN_Domain,DIRECT
  - RULE-SET,CloudflareCN,DIRECT
  - RULE-SET,AmazonCN,DIRECT
  - RULE-SET,CN_Mainland,DIRECT
  - RULE-SET,LAN,DIRECT

  # 大陆域名规则未命中的大陆 IP 兜底；前面的服务专用代理规则优先级更高。
  - GEOIP,CN,DIRECT
  - MATCH,Final

rule-providers: #!replace
  Reject:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Reject.list

  AI:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AI.list

  YouTube:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/YouTube.list

  Telegram:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Telegram.list

  TikTok:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/TikTok.list

  Binance:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Binance/Binance.yaml

  Bybit:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/bybit.list

  AppleCN:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AppleCN.list

  AppleServers:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AppleServers.list

  TestFlight:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/TestFlight/TestFlight.yaml

  CN_Mainland:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/ChinaDomain.list

  # 上游 WhiteList-02-Min.AntiAD 使用的高精度中国域名集合。
  # ChinaMax（近十万条）按上游模板默认保持关闭，避免移动端内存和功耗开销。
  GeositeCN_Domain:
    behavior: domain
    format: yaml
    interval: 86400
    url: https://cdn.jsdelivr.net/gh/Accademia/Additional_Rule_For_Clash@latest/GeositeCN/GeositeCN_Domain.yaml

  CloudflareCN:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Cloudflarecn/Cloudflarecn.yaml

  AmazonCN:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AmazonCN/AmazonCN.yaml

  LAN:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Lan.list

  APNs:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/QuixoticHeart/rule-set/refs/heads/ruleset/stash/apns.list
