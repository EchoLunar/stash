---
name: 自用覆写
desc: 3x-ui 仅负责下发节点；本覆写接管 DNS、策略组、规则和规则集。🍻！
icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/AmyTelecom.png

mode: rule
log-level: warning
ipv6: true
unified-delay: true

profile:
  store-selected: true

# 开启嗅探，帮助 Stash 从 IP 连接中恢复域名并继续命中分流规则。
# 不启用 force-domain，避免对普通域名连接做额外嗅探。
sniffer: #!replace
  enable: true
  override-destination: false
  sniff:
    HTTP:
      ports:
        - 80
        - 8080-8880
      override-destination: true
    TLS:
      ports:
        - 443
        - 8443
    QUIC:
      ports:
        - 443
        - 8443
  # 这些服务对 SNI/目的地址比较敏感，跳过嗅探以减少兼容性问题。
  skip-domain:
    - Mijia Cloud
    - dlg.io.mi.com
    - '+.apple.com'
    - '+.icloud.com'
    - '+.wechat.com'
    - '+.qpic.cn'
    - '+.qq.com'
    - '+.wechatapp.com'
    - '+.vivox.com'
    - '+.oray.com'
    - '+.sunlogin.net'

# 完全替换订阅中的 DNS，避免与 3x-ui 生成配置递归合并。
dns: #!replace
  enable: true
  use-system-hosts: false
  ipv6: true
  listen: 0.0.0.0:53
  # 使用 Fake IP，代理请求尽量保留域名交给代理链路解析，避免本地 DNS 提前选错 CDN。
  enhanced-mode: fake-ip

  # bootstrap 使用国内 IPv4 DNS，仅用于解析 DoH 服务和代理节点的域名。
  # 主 DNS 仍使用 DoH；国内 bootstrap 比境外 IP DoH 更适合中国网络环境。
  default-nameserver: #!replace
    - 119.29.29.29
    - 223.5.5.5

  # 中国域名优先使用国内 DoH；其他需要真实解析的域名使用境外 DoH。
  # Stash 官方支持 geosite 匹配；rule-set 放在 nameserver-policy 中不依赖。
  nameserver:
    - https://cloudflare-dns.com/dns-query
    - https://dns.google/dns-query

  nameserver-policy:
    'geosite:cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

  # 这些服务需要真实 IP，避免 Fake IP 影响连通性。
  fake-ip-filter:
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'lens.l.google.com'
    - '*.n.n.srv.nintendo.net'
    - '+.stun.playstation.net'
    - 'xbox.*.*.microsoft.com'
    - '*.*.xboxlive.com'
    - '*.msftncsi.com'
    - '*.msftconnecttest.com'

  # 代理节点本身也是域名，使用独立国内 DoH 解析，避免连接代理时形成 DNS 递归。
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  # Fake IP 已避免代理请求的本地解析；普通 DNS 保持直连，避免通用 Proxy 组影响 CDN 地域判断。
  follow-rule: false

# 不覆写 proxies。所有真实节点始终由 3x-ui 订阅下发。
# Proxy 是所有未命中规则流量的代理入口；AI、Talkatone、Binance、Bybit、Polymarket 和 TikTok
# 按需直接收纳订阅中的全部节点。
proxy-groups: #!replace
  - name: Proxy
    type: select
    include-all: true

  - name: Final
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: AI
    type: select
    include-all: true

  - name: Apple
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: APNs
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: TestFlight
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Talkatone
    type: select
    include-all: true

  - name: Binance
    type: select
    include-all: true

  - name: Bybit
    type: select
    include-all: true

  - name: Polymarket
    type: select
    include-all: true

  - name: TikTok
    type: select
    include-all: true

rules: #!replace
  # WebRTC/STUN 防泄露：拦截协议识别到的 STUN，以及常见 STUN/TURN 端口。
  # 这会关闭基于 STUN 的 WebRTC/P2P 直连，也可能降低部分实时通话或 Tailscale
  # 的直连能力；如果你更看重这些功能，可删除下面 4 条规则。
  - PROTOCOL,STUN,REJECT-DROP
  - AND,((NETWORK,udp),(DST-PORT,3478-3497)),REJECT-DROP
  - AND,((NETWORK,tcp),(DST-PORT,5349)),REJECT-DROP
  - AND,((NETWORK,udp),(DST-PORT,19302-19309)),REJECT-DROP

  # 模板中的反 HTTPDNS 能力：内置 geosite 先拦截分类域名，规则集补充域名和 IP。
  - GEOSITE,category-httpdns-cn,REJECT-DROP
  - RULE-SET,BlockHTTPDNS,REJECT-DROP

  # 个人固定例外：Oracle VPS 及 Oracle 控制台域名直连。
  # cloud.oracle.com 属于 oracle.com，DOMAIN-SUFFIX 会覆盖其子域名。
  - IP-CIDR,149.118.147.51/32,DIRECT,no-resolve
  - IP-CIDR6,2603:c030:304:9f01:0:49da:2c15:4454/128,DIRECT,no-resolve
  - IP-CIDR,149.118.135.225/32,DIRECT,no-resolve
  - IP-CIDR6,2603:c030:304:9f01:0:11b3:17c:f41d/128,DIRECT,no-resolve
  - DOMAIN-SUFFIX,oracle.com,DIRECT
  - DOMAIN-SUFFIX,oraclecloud.com,DIRECT
  - DOMAIN-SUFFIX,5202323.xyz,DIRECT

  # 个人固定代理例外。
  - DOMAIN-SUFFIX,dmit.io,Proxy
  - DOMAIN-SUFFIX,4hu.com,Proxy
  - DOMAIN-SUFFIX,4hu.tv,Proxy

  # 内置 DNS 已关闭 follow-rule；以下规则只约束应用主动访问这些 DNS 服务域名时的流量。
  - DOMAIN-SUFFIX,doh.pub,DIRECT
  - DOMAIN-SUFFIX,dns.alidns.com,DIRECT
  - DOMAIN-SUFFIX,cloudflare-dns.com,Proxy
  - DOMAIN-SUFFIX,dns.google,Proxy

  - DOMAIN-SUFFIX,talkatone.com,Talkatone
  - DOMAIN-SUFFIX,tktn.be,Talkatone
  - DOMAIN-SUFFIX,tktn.at,Talkatone
  - RULE-SET,Binance,Binance
  - DOMAIN-KEYWORD,binance,Binance
  - RULE-SET,Bybit,Bybit
  - DOMAIN-KEYWORD,polymarket,Polymarket
  - RULE-SET,APNs,APNs
  - RULE-SET,TestFlight,TestFlight
  - RULE-SET,Reject,REJECT

  - RULE-SET,AI,AI
  - RULE-SET,YouTube,Proxy
  - RULE-SET,Telegram,Proxy
  - RULE-SET,TikTok,TikTok
  - RULE-SET,AppleCN,DIRECT
  - RULE-SET,AppleServers,Apple
  # 以下是国内识别链：域名规则优先，GEOIP,CN 只负责 IP 兜底。
  - RULE-SET,GeositeCN_Domain,DIRECT
  - RULE-SET,CloudflareCN,DIRECT
  - RULE-SET,AmazonCN,DIRECT
  - RULE-SET,CN_Mainland,DIRECT
  - RULE-SET,LAN,DIRECT

  # 大陆域名规则未命中的大陆 IP 兜底；前面的服务专用代理规则优先级更高。
  - GEOIP,CN,DIRECT,no-resolve
  - MATCH,Final

rule-providers: #!replace
  # 反 HTTPDNS 规则，避免应用绕过系统 DNS 直接把解析请求发往第三方服务。
  BlockHTTPDNS:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@latest/rule/Clash/BlockHttpDNS/BlockHttpDNS.yaml

  Reject:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Reject.list

  AI:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AI.list

  YouTube:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/YouTube.list

  Telegram:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Telegram.list

  TikTok:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/TikTok.list

  Binance:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Binance/Binance.yaml

  Bybit:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/bybit.list

  AppleCN:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AppleCN.list

  AppleServers:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AppleServers.list

  TestFlight:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/TestFlight/TestFlight.yaml

  CN_Mainland:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/ChinaDomain.list

  # 上游 WhiteList-02-Min.AntiAD 使用的高精度中国域名集合。
  # ChinaMax（近十万条）按上游模板默认保持关闭，避免移动端内存和功耗开销。
  GeositeCN_Domain:
    behavior: domain
    format: yaml
    interval: 86400
    url: https://cdn.jsdelivr.net/gh/Accademia/Additional_Rule_For_Clash@latest/GeositeCN/GeositeCN_Domain.yaml

  CloudflareCN:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Cloudflarecn/Cloudflarecn.yaml

  AmazonCN:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AmazonCN/AmazonCN.yaml

  LAN:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Lan.list

  APNs:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/QuixoticHeart/rule-set/refs/heads/ruleset/stash/apns.list
