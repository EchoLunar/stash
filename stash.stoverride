---
name: 自用覆写
desc: 3x-ui 仅负责下发节点；本覆写接管 DNS、策略组、规则和规则集。🍻！
icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/AmyTelecom.png

mode: rule
log-level: warning
ipv6: true
unified-delay: true

profile:
  store-selected: true

# 完全替换订阅中的 DNS，避免与 3x-ui 生成配置递归合并。
dns: #!replace
  enable: true
  use-system-hosts: false
  ipv6: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.localhost'
    - 'stun.*.*.*'
    - 'stun.*.*'
    - time.windows.com
    - time.nist.gov
    - time.apple.com
    - time.asia.apple.com
    - '*.ntp.org.cn'
    - '*.openwrt.pool.ntp.org'
    - time1.cloud.tencent.com
    - time.ustc.edu.cn
    - pool.ntp.org
    - ntp.ubuntu.com
    - ntp.aliyun.com
    - ntp1.aliyun.com
    - ntp2.aliyun.com
    - ntp3.aliyun.com
    - ntp4.aliyun.com
    - ntp5.aliyun.com
    - ntp6.aliyun.com
    - ntp7.aliyun.com
    - time1.aliyun.com
    - time2.aliyun.com
    - time3.aliyun.com
    - time4.aliyun.com
    - time5.aliyun.com
    - time6.aliyun.com
    - time7.aliyun.com
    - '*.time.edu.cn'
    - time1.apple.com
    - time2.apple.com
    - time3.apple.com
    - time4.apple.com
    - time5.apple.com
    - time6.apple.com
    - time7.apple.com
    - time1.google.com
    - time2.google.com
    - time3.google.com
    - time4.google.com
    - music.163.com
    - '*.music.163.com'
    - '*.126.net'
    - musicapi.taihe.com
    - music.taihe.com
    - songsearch.kugou.com
    - trackercdn.kugou.com
    - '*.kuwo.cn'
    - y.qq.com
    - '*.y.qq.com'
    - streamoc.music.tc.qq.com
    - mobileoc.music.tc.qq.com
    - isure.stream.qqmusic.qq.com
    - dl.stream.qqmusic.qq.com
    - aqqmusic.tc.qq.com
    - amobile.music.tc.qq.com
    - '*.xiami.com'
    - '*.music.migu.cn'
    - music.migu.cn
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
    - '*.srv.nintendo.net'
    - '*.stun.playstation.net'
    - 'xbox.*.microsoft.com'
    - '*.ipv6.microsoft.com'
    - '*.xboxlive.com'
    - speedtest.cros.wr.pvp.net
    - localhost.ptlogin2.qq.com

  default-nameserver:
    - 119.29.29.29
    - 223.5.5.5

  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query

# 不覆写 proxies。所有真实节点始终由 3x-ui 订阅下发。
# Proxy 和 Polymarket 直接收纳订阅中的全部节点。
proxy-groups: #!replace
  - name: Proxy
    type: select
    include-all: true
    proxies:
      - DIRECT

  - name: Final
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: AI
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Apple
    type: select
    proxies:
      - DIRECT
      - Proxy

  - name: APNs
    type: select
    proxies:
      - DIRECT
      - Proxy

  - name: TestFlight
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Amazon
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: YouTube
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Telegram
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Talkatone
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Binance
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Polymarket
    type: select
    include-all: true
    proxies:
      - Proxy
      - DIRECT

  - name: GitHub
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Streaming
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: TikTok
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Google
    type: select
    proxies:
      - Proxy
      - DIRECT

  - name: Microsoft
    type: select
    proxies:
      - DIRECT
      - Proxy

  - name: Games
    type: select
    proxies:
      - Proxy
      - DIRECT

rules: #!replace
  - DOMAIN-SUFFIX,talkatone.com,Talkatone
  - DOMAIN-SUFFIX,tktn.be,Talkatone
  - DOMAIN-SUFFIX,tktn.at,Talkatone
  - DOMAIN-KEYWORD,polymarket,Polymarket
  - RULE-SET,Binance,Binance
  - DOMAIN-KEYWORD,binance,Binance
  - RULE-SET,APNs,APNs
  - RULE-SET,TestFlight,TestFlight
  - RULE-SET,Reject,REJECT
  - RULE-SET,Direct,DIRECT
  - RULE-SET,AI,AI
  - RULE-SET,Amazon,Amazon
  - RULE-SET,YouTube,YouTube
  - RULE-SET,Telegram,Telegram
  - RULE-SET,GitHub,GitHub
  - RULE-SET,TikTok,TikTok
  - RULE-SET,Google,Google
  - RULE-SET,Microsoft,Microsoft
  - RULE-SET,Games,Games
  - RULE-SET,AppleCN,DIRECT
  - RULE-SET,AppleServers,Apple
  - RULE-SET,ProxyMedia,Streaming
  - RULE-SET,ProxyGFW,Proxy
  - RULE-SET,CN_Mainland,DIRECT
  - RULE-SET,LAN,DIRECT
  - MATCH,Final

rule-providers: #!replace
  Reject:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Reject.list

  Direct:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Direct.list

  AI:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AI.list

  Amazon:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Amazon/Amazon.yaml

  YouTube:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/YouTube.list

  Telegram:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Telegram.list

  GitHub:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Github.list

  TikTok:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/TikTok.list

  Google:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Google.list

  Microsoft:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Microsoft.list

  Games:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Game.list

  Binance:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Binance/Binance.yaml

  ProxyMedia:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/ProxyMedia.list

  ProxyGFW:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/ProxyGFW.list

  AppleCN:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AppleCN.list

  AppleServers:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/AppleServers.list

  TestFlight:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/TestFlight/TestFlight.yaml

  CN_Mainland:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/ChinaDomain.list

  LAN:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/Lan.list

  APNs:
    behavior: classical
    format: text
    interval: 86400
    url: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Stash/Rules/APNs.list
