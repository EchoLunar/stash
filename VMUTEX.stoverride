---
name: VMUTEX 分流与 DNS # 覆写在 Stash 中显示的名称。
desc: 六个手选分组及简化 DNS，Oracle 可选直连或 PROXY；需要 Stash iOS/tvOS 3.6+ 或 macOS 4.3+。 # 覆写说明与最低版本。

# 作为现有节点订阅的覆写使用。启用前先为代理业务组选择节点；Oracle 默认直连。
# 规则 / DNS / 分组整体替换，节点和节点订阅由基础配置提供。
mode: rule # 按下方 rules 顺序匹配连接。
log-level: info # 记录常规运行信息，便于查看分流结果。

# #!replace 是 Stash 覆写指令：整块替换基础配置中的 DNS，避免混入旧上游。
dns: #!replace
  follow-rule: true # DoH 请求按下方专用规则出站；代理域名不直连本地解析器。
  fake-ip-filter: # 列出需要真实 IP、不能返回 Fake IP 的域名。
    - 'geosite:private' # 仅豁免私有名称；并非“所有私有 IP”，详见 README。
  default-nameserver: # 解析下面 DoH 服务器域名时的启动 DNS。
    - system # 使用当前系统网络提供的 DNS，避免 DoH 域名依赖自身解析。
  proxy-server-nameserver: # 独立解析代理节点的服务器域名，不走代理规则。
    - https://dns.alidns.com/dns-query # 阿里 DoH；节点域名解析候选上游之一。
    - https://doh.pub/dns-query # DNSPod DoH；与上一条并发，取先成功的结果。
  nameserver: # 未命中下方 policy 的真实查询经 PROXY 访问 Cloudflare DoH。
    - https://1.1.1.1/dns-query # 使用 IP 端点，避免解析器自身的域名启动查询。
  nameserver-policy: # 集合 policy 按书写顺序首个命中；顺序对应业务规则。
    'rule-set:oracle': # Oracle 列表中只有域名条目参与 DNS policy。
      - https://dns.google/dns-query # 由 Oracle 组选择 DNS 出口，切换 PROXY 时不走本地 DNS。
    'rule-set:Crypto': # 加密货币合集的域名。
      - https://cloudflare-dns.com/dns-query # DoH 跟随 Crypto 所选出口。
    'geosite:private': # V2Fly private 域名集，如 .local、.lan、home.arpa。
      - system # 私有名称交给当前网络的系统 DNS，不送到公共 DoH。
    'geosite:category-ai-!cn': # 境外 AI 域名优先于后面的国内分类。
      - https://1.0.0.1/dns-query # DoH 跟随 AI 所选出口。
    'geosite:youtube': # YouTube 域名。
      - https://dns10.quad9.net/dns-query # DoH 跟随 YouTube 所选出口。
    'geosite:netflix': # Netflix 域名可能与宽泛地区分类重叠。
      - https://1.1.1.1/dns-query # DoH 经 PROXY 出口。
    'geosite:telegram': # Telegram 域名。
      - https://unfiltered.adguard-dns.com/dns-query # DoH 跟随 Telegram 所选出口。
    'geosite:disney,hbo,spotify,tiktok,twitch,primevideo,bahamut': # 第一组流媒体域名。
      - https://1.1.1.1/dns-query # DoH 经 PROXY 出口。
    'rule-set:BiliIntl': # Bilibili 国际站域名优先于 Bilibili 直连分类。
      - https://1.1.1.1/dns-query # DoH 经 PROXY 出口。
    'geosite:dazn,hulu,abema,bbc,dmm,niconico,viu,soundcloud,discoveryplus': # 第二组流媒体域名。
      - https://1.1.1.1/dns-query # DoH 经 PROXY 出口。
    'geosite:epicgames,origin,sony,nintendo,steam,github': # 游戏和 GitHub 域名。
      - https://1.1.1.1/dns-query # DoH 经 PROXY 出口。
    'geosite:apple,microsoft,bilibili': # 未被前面代理分类命中的固定直连域名。
      - https://dns.alidns.com/dns-query # 本地阿里 DoH；直连服务尽量取得本地 CDN 地址。
      - https://doh.pub/dns-query # 本地 DNSPod DoH；与上一条并发。
    'geosite:googlefcm,geolocation-!cn': # Google FCM 与其他境外域名。
      - https://1.1.1.1/dns-query # DoH 经 PROXY 出口。
    'geosite:cn': # 未被前面代理分类命中的中国大陆域名。
      - https://dns.alidns.com/dns-query # 本地阿里 DoH。
      - https://doh.pub/dns-query # 本地 DNSPod DoH；与上一条并发。

# #!replace 整块替换基础配置中的策略组；不替换节点本身。
# Stash 空策略组会按 DIRECT 处理；显式保留 REJECT，确保组始终非空。
# REJECT 也可手动选择；include-all 继续纳入基础配置中的全部节点和代理集。
proxy-groups: #!replace
  - name: PROXY # 境外流量的总代理组，也是其他业务组可选择的上游。
    type: select # 由用户手动选择组内出口。
    include-all: true # 纳入基础配置中的节点和其他可用代理集。
    proxies: # 额外列出的固定选项。
      - REJECT # 保证组非空；选中时拒绝流量。
  - name: Oracle # 自有 VPS 与 Oracle 域名的手选组。
    type: select # 手动选择直连或跟随 PROXY。
    proxies: # Oracle 只提供以下两个出口。
      - DIRECT # 从当前设备直接连接。
      - PROXY # 使用 PROXY 当前选定的节点。
  - name: AI # 境外 AI 服务的手选组。
    type: select # 手动选择出口。
    include-all: true # 允许直接挑选订阅节点或代理集。
    proxies: # 额外列出的固定选项。
      - REJECT # 显式拒绝，避免空组选成直连。
      - PROXY # 跟随总代理组。
  - name: YouTube # YouTube 服务的手选组。
    type: select # 手动选择出口。
    include-all: true # 允许直接挑选订阅节点或代理集。
    proxies: # 额外列出的固定选项。
      - REJECT # 显式拒绝，避免空组选成直连。
      - PROXY # 跟随总代理组。
  - name: Telegram # Telegram 服务的手选组。
    type: select # 手动选择出口。
    include-all: true # 允许直接挑选订阅节点或代理集。
    proxies: # 额外列出的固定选项。
      - REJECT # 显式拒绝，避免空组选成直连。
      - PROXY # 跟随总代理组。
  - name: Crypto # 加密货币服务合集的手选组，与 Mihomo 同名。
    type: select # 手动选择出口。
    include-all: true # 允许直接挑选订阅节点或代理集。
    proxies: # 额外列出的固定选项。
      - DIRECT # 与 Mihomo 一样允许加密货币业务直连；首次加载时位于首项。
      - PROXY # 跟随总代理组。
      - REJECT # 显式拒绝，避免空组选成直连。

# 从上到下匹配，第一条命中的规则决定连接出口；#!replace 整块替换基础规则。
# 前八条给 DNS 上游指定出口，也会匹配应用直接访问相同地址的连接。
# 其余业务规则与 VMUTEX.yaml 对齐。
# Mihomo 的 private 标签转为 Stash 的 LAN。
rules: #!replace
  - DOMAIN,dns.google,Oracle # Oracle 专用 DoH 跟随 Oracle 组；命名端点优先于通用规则。
  - DOMAIN,cloudflare-dns.com,Crypto # Crypto 专用 DoH 跟随 Crypto 组。
  - IP-CIDR,1.0.0.1/32,AI,no-resolve # AI 专用 DoH IP 跟随 AI 组，不解析端点。
  - DOMAIN,dns10.quad9.net,YouTube # YouTube 专用 DoH 跟随 YouTube 组。
  - DOMAIN,unfiltered.adguard-dns.com,Telegram # Telegram 专用 DoH 跟随 Telegram 组。
  - DOMAIN,dns.alidns.com,DIRECT # 国内 DoH 固定本地直连，保持本地 CDN 选址。
  - DOMAIN,doh.pub,DIRECT # 第二个国内 DoH 固定本地直连。
  - IP-CIDR,1.1.1.1/32,PROXY,no-resolve # 通用境外 DoH IP 经 PROXY，不解析端点。
  - RULE-SET,oracle,Oracle # 自有 VPS IP 和 Oracle / 自有域名走 Oracle 组。
  - RULE-SET,Crypto,Crypto # 与 Mihomo 共用加密货币合集，涵盖交易所、钱包等域名。
  - GEOIP,LAN,DIRECT,no-resolve # 已知局域网目标 IP 直连，不为此规则解析域名。
  - GEOSITE,private,DIRECT # V2Fly private 域名集直连；仅匹配名称，不匹配私有 IP。
  - GEOSITE,category-ai-!cn,AI # 境外 AI 域名走 AI 组。
  - GEOSITE,youtube,YouTube # YouTube 域名走 YouTube 组。
  - GEOSITE,netflix,PROXY # Netflix 域名走总代理组。
  - RULE-SET,NetflixIP,PROXY,no-resolve # Netflix IP 列表走总代理组，不触发域名解析。
  - GEOSITE,telegram,Telegram # Telegram 域名走 Telegram 组。
  - RULE-SET,TelegramIP,Telegram,no-resolve # Telegram IP 列表走 Telegram 组，不触发域名解析。
  - GEOSITE,disney,PROXY # Disney 域名走总代理组。
  - GEOSITE,hbo,PROXY # HBO 域名走总代理组。
  - GEOSITE,spotify,PROXY # Spotify 域名走总代理组。
  - GEOSITE,tiktok,PROXY # TikTok 域名走总代理组。
  - GEOSITE,twitch,PROXY # Twitch 域名走总代理组。
  - GEOSITE,primevideo,PROXY # Prime Video 域名走总代理组。
  - GEOSITE,bahamut,PROXY # 巴哈姆特域名走总代理组。
  - RULE-SET,BiliIntl,PROXY # 使用 MetaCubeX 国际站列表，优先于后面的 Bilibili 直连规则。
  - GEOSITE,dazn,PROXY # DAZN 域名走总代理组。
  - GEOSITE,hulu,PROXY # Hulu 域名走总代理组。
  - GEOSITE,abema,PROXY # Abema 域名走总代理组。
  - GEOSITE,bbc,PROXY # BBC 域名走总代理组。
  - GEOSITE,dmm,PROXY # DMM 域名走总代理组。
  - GEOSITE,niconico,PROXY # Niconico 域名走总代理组。
  - GEOSITE,viu,PROXY # Viu 域名走总代理组。
  - GEOSITE,soundcloud,PROXY # SoundCloud 域名走总代理组。
  - GEOSITE,discoveryplus,PROXY # Discovery+ 域名走总代理组。
  - GEOSITE,epicgames,PROXY # Epic Games 域名走总代理组。
  - GEOSITE,origin,PROXY # Origin / EA 相关域名走总代理组。
  - GEOSITE,sony,PROXY # Sony 域名走总代理组。
  - GEOSITE,nintendo,PROXY # Nintendo 域名走总代理组。
  - GEOSITE,steam,PROXY # Steam 域名走总代理组。
  - GEOSITE,github,PROXY # GitHub 域名走总代理组。
  - GEOSITE,apple,DIRECT # 未被上面规则先命中的 Apple 域名直连。
  - GEOSITE,microsoft,DIRECT # 未被上面规则先命中的 Microsoft 域名直连。
  - GEOSITE,bilibili,DIRECT # 未被国际站规则先命中的 Bilibili 域名直连。
  - GEOSITE,googlefcm,PROXY # Google FCM 推送域名走总代理组。
  - GEOSITE,geolocation-!cn,PROXY # 其他非中国大陆地理分类域名走总代理组。
  - GEOSITE,cn,DIRECT # 中国大陆域名集直连。
  - GEOIP,CN,DIRECT,no-resolve # 只按已有目标 IP 判断中国大陆直连；域名不为此规则提前解析。
  - MATCH,PROXY # 以上规则均未命中时走总代理组。

# #!replace 整块替换基础配置的规则提供器；每个名称由上方 RULE-SET 引用。
# classical 可混合域名与 IP 规则；domain 只承载域名匹配。
rule-providers: #!replace
  oracle: # 自有 VPS 与 Oracle 域名的远程列表。
    behavior: classical # 列表中同时包含域名规则和 IP 规则。
    format: text # 上游文件按逐行文本规则读取。
    url: https://raw.githubusercontent.com/EchoLunar/stash/refs/heads/main/Rules/oracle.list # 规则下载地址。
    path: ./ruleset/oracle.list # Stash 保存下载结果的本地路径。
    interval: 86400 # 每 86400 秒检查一次更新，即 24 小时。
  Crypto: # 与 Mihomo 共用 MetaCubeX 加密货币合集。
    behavior: classical # 按完整规则语法匹配。
    format: text # 上游文件按逐行文本规则读取。
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/category-cryptocurrency.list # 与 Mihomo 相同的规则下载地址。
    path: ./ruleset/Crypto.list # Stash 本地缓存路径。
    interval: 86400 # 每 24 小时检查一次更新。
  BiliIntl: # MetaCubeX 国际站完整域名列表，与 Mihomo 的 geosite 来源一致。
    behavior: domain # 列表只包含域名模式。
    format: text # 上游文件按逐行文本域名读取。
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/biliintl.list # 国际站规则下载地址。
    path: ./ruleset/BiliIntl.list # Stash 本地缓存路径。
    interval: 86400 # 每 24 小时检查一次更新。
  NetflixIP: # Netflix 的远程 IP 规则列表。
    behavior: classical # 按完整 IP 规则语法匹配。
    format: text # 上游文件按逐行文本规则读取。
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/classical/netflix.list # 规则下载地址。
    path: ./ruleset/NetflixIP.list # Stash 本地缓存路径。
    interval: 86400 # 每 24 小时检查一次更新。
  TelegramIP: # Telegram 的远程 IP 规则列表。
    behavior: classical # 按完整 IP 规则语法匹配。
    format: text # 上游文件按逐行文本规则读取。
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/classical/telegram.list # 规则下载地址。
    path: ./ruleset/TelegramIP.list # Stash 本地缓存路径。
    interval: 86400 # 每 24 小时检查一次更新。
